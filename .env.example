# ============================================================================
#  GoldenShake — environment configuration
# ----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#  NEVER commit the resulting `.env` — it is git-ignored on purpose.
# ============================================================================

# ----------------------------------------------------------------------------
# CORE DJANGO
# ----------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string
# NEVER set this to true in production.
DJANGO_DEBUG=false
# Comma-separated hostnames Django will serve. Add your real domain(s).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
TIME_ZONE=UTC

# Public URL of the Next.js frontend. Used for CORS, invite links and
# garant private deal links. No trailing slash.
FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins trusted for CSRF-protected form posts (comma separated, needs scheme).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost

# HTTPS hardening — enable both once you terminate TLS at nginx/your LB.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------------------------------------------
# `db` is the docker-compose service name; use `localhost` for a local server.
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=goldenshake
POSTGRES_USER=goldenshake
POSTGRES_PASSWORD=change-this-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Persistent connection lifetime in seconds (0 disables pooling).
DB_CONN_MAX_AGE=60

# ----------------------------------------------------------------------------
# REDIS — cache, Channels layer and Celery transport
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Run tasks synchronously in-process (tests/local only).
CELERY_TASK_ALWAYS_EAGER=false
# Use an in-memory Channels layer instead of Redis (tests/local only).
USE_INMEMORY_CHANNEL_LAYER=false

# ----------------------------------------------------------------------------
# JWT AUTHENTICATION (djangorestframework-simplejwt)
# ----------------------------------------------------------------------------
# Leave blank to reuse DJANGO_SECRET_KEY, or set a dedicated signing key.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# ----------------------------------------------------------------------------
# MESSAGE ENCRYPTION (PyNaCl / libsodium)
# ----------------------------------------------------------------------------
# 32 random bytes, base64-encoded. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: rotating this key makes every stored message unreadable.
MESSAGE_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# EMAIL / SMTP
# ----------------------------------------------------------------------------
# Only these providers may register (enforced server-side in
# apps/accounts/validators.py — see settings.ALLOWED_EMAIL_DOMAINS):
#   gmail.com, yahoo.com, protonmail.com, tutanota.com, tutamail.com, mail.ru
#
# Gmail:      smtp.gmail.com:587 — create an App password at
#             https://myaccount.google.com/apppasswords (2FA required)
# Yahoo:      smtp.mail.yahoo.com:587 — App password in Account Security
# ProtonMail: 127.0.0.1:1025 via the Proton Mail Bridge (paid plan)
# Mail.ru:    smtp.mail.ru:587 — "password for external applications"
# Or use an implicit-SSL relay on port 465 by setting EMAIL_USE_SSL=true and
# EMAIL_USE_TLS=false.
EMAIL_HOST=your-smtp-host
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL="GoldenShake <no-reply@goldenshake.app>"
# How long a 6-digit e-mail OTP stays valid.
EMAIL_CODE_TTL_MINUTES=10

# ----------------------------------------------------------------------------
# MEDIA STORAGE — S3 or MinIO (django-storages + boto3)
# ----------------------------------------------------------------------------
# false = store uploads on the local filesystem (./backend/media)
USE_S3=false
# AWS S3: create an IAM user with s3:PutObject/GetObject on your bucket at
#   https://console.aws.amazon.com/iam/
# MinIO: these are the MINIO_ROOT_USER / MINIO_ROOT_PASSWORD of the container.
AWS_ACCESS_KEY_ID=goldenshake
AWS_SECRET_ACCESS_KEY=change-this-minio-secret
AWS_STORAGE_BUCKET_NAME=goldenshake-media
AWS_S3_REGION_NAME=us-east-1
# Leave blank for real AWS S3; set to http://minio:9000 for the bundled MinIO.
AWS_S3_ENDPOINT_URL=http://minio:9000
# Seconds a pre-signed media URL remains valid.
AWS_QUERYSTRING_EXPIRE=3600

# ----------------------------------------------------------------------------
# CRYPTOPAY — garant (escrow) payments
# ----------------------------------------------------------------------------
# 1. Open https://t.me/CryptoBot  →  Crypto Pay  →  Create App
# 2. Copy the API token it hands you into CRYPTOPAY_API_TOKEN
# 3. Set the webhook URL to https://your-domain/api/v1/garant/webhook/cryptopay/
# 4. Use the same app token as the webhook signing secret
# Testnet endpoint: https://testnet-pay.crypt.bot/api
CRYPTOPAY_API_URL=https://pay.crypt.bot/api
CRYPTOPAY_API_TOKEN=
CRYPTOPAY_WEBHOOK_SECRET=
# Percentage the platform keeps from every released escrow deal.
GARANT_PLATFORM_FEE_PCT=5

# ----------------------------------------------------------------------------
# TELEGRAM BOT — used as the SMS/2FA delivery channel
# ----------------------------------------------------------------------------
# 1. Talk to https://t.me/BotFather  →  /newbot
# 2. Paste the HTTP API token below
# 3. Users link their account by saving their numeric chat ID in Settings
# TELEGRAM_SMS_CHAT_ID is an optional fallback/ops channel for platform alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SMS_CHAT_ID=

# ----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING — mobile/web push
# ----------------------------------------------------------------------------
# 1. https://console.firebase.google.com  →  Project settings  →  Service accounts
# 2. "Generate new private key" → save the JSON next to docker-compose.yml
# 3. Point FCM_CREDENTIALS_FILE at it (it is git-ignored)
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=/app/firebase-credentials.json

# ----------------------------------------------------------------------------
# PLATFORM RULES
# ----------------------------------------------------------------------------
# How many people a single invite link may admit.
INVITE_MAX_USES=5

# ----------------------------------------------------------------------------
# FRONTEND (Next.js) — must be reachable from the user's browser
# ----------------------------------------------------------------------------
# Behind the bundled nginx these are just http://localhost and ws://localhost.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ----------------------------------------------------------------------------
# DOCKER COMPOSE PORT MAPPING
# ----------------------------------------------------------------------------
HTTP_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
